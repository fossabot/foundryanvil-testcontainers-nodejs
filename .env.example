# Optional: enables the forking e2e test (test/e2e).
ANVIL_FORK_URL=
ANVIL_FORK_BLOCK_NUMBER=
# Optional: e2e mode for plain `pnpm test` runs: docker | local | skip
# (`pnpm test:e2e` / `pnpm test:e2e --no-docker` set this automatically).
ANVIL_E2E_MODE=
# Optional: override the anvil executable used by `pnpm test:e2e --no-docker`
# (local testing only). Defaults to the bundled @foundry-rs/anvil devDependency.
ANVIL_BINARY=
