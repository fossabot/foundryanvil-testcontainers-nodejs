{
  "name": "foundryanvil-testcontainers-docs",
  "version": "1.0.0",
  "private": true,
  "description": "Documentation site for @hellaweb3/foundryanvil-testcontainers-nodejs. Every code sample is synced from a tested #region in ../examples.",
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "build": "docusaurus build",
    "serve": "docusaurus serve",
    "clear": "docusaurus clear",
    "sync": "node scripts/sync.mts",
    "check": "node scripts/sync.mts --check",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:unit": "node --test --test-reporter=spec \"test/unit/**/*.test.mts\"",
    "test:coverage": "node --test --test-reporter=spec --experimental-test-coverage --test-coverage-include=\"plugins/**\" --test-coverage-include=\"scripts/**\" --test-coverage-lines=95 --test-coverage-branches=90 --test-coverage-functions=95 \"test/unit/**/*.test.mts\"",
    "test:e2e": "node scripts/e2e.mts",
    "verify": "npm run check && npm run typecheck && npm run lint && npm run test:unit && npm run test:e2e"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@mdx-js/react": "^3.1.1",
    "clsx": "^2.1.1",
    "docusaurus-plugin-llms": "^0.6.2",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@eslint/js": "^10.0.1",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.14.0",
    "mdast-util-from-markdown": "^2.1.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.2"
  }
}
