{
  "name": "@hellaweb3/foundryanvil-testcontainers-nodejs",
  "description": "Fluent, type-safe Testcontainers module for Foundry Anvil: every anvil CLI flag with conflict/dependency validation, reliable startup, host/container state transfer and a chain-aware viem test client with helpers.",
  "homepage": "https://github.com/hella-web3/foundryanvil-testcontainers-nodejs#readme",
  "repository": "https://github.com/hella-web3/foundryanvil-testcontainers-nodejs",
  "bugs": "https://github.com/hella-web3/foundryanvil-testcontainers-nodejs/issues",
  "keywords": [
    "testcontainers",
    "foundry",
    "anvil",
    "ethereum",
    "viem",
    "evm"
  ],
  "version": "0.5.0",
  "license": "MIT",
  "author": "Chris Anatalio",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "tsdx dev",
    "build": "tsdx build && node scripts/compact-dist.mjs",
    "test": "jest --colors --injectGlobals",
    "test:unit": "jest --colors --injectGlobals test/unit",
    "test:e2e": "node scripts/e2e.mjs",
    "test:coverage": "jest --colors --injectGlobals --coverage test/unit",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "examples:setup": "pnpm build && npm link && cd examples && npm install && npm run link:library",
    "examples:unit": "pnpm examples:setup && cd examples && npm run typecheck && npm run lint && npm run test:unit",
    "examples:e2e": "pnpm examples:setup && cd examples && npm run typecheck && npm run lint && npm run test:e2e",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build",
    "check:local": "pnpm build && pnpm typecheck && pnpm lint && pnpm test:unit && pnpm test:e2e --no-docker && pnpm examples:unit && pnpm examples:e2e --no-docker",
    "check:docker": "pnpm build && pnpm typecheck && pnpm lint && pnpm test:unit && pnpm test:e2e && pnpm examples:unit && pnpm examples:e2e "
  },
  "dependencies": {
    "testcontainers": "^12.2.0",
    "viem": "^2.57.20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@foundry-rs/anvil": "1.6.0-rc1",
    "@swc/core": "^1.16.22",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "bunchee": "^7.1.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "prettier": "^3.10.1",
    "tsdx": "^2.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2"
  },
  "jest": {
    "collectCoverageFrom": [
      "src/**/*.ts"
    ],
    "coverageDirectory": "coverage",
    "coverageThreshold": {
      "global": {
        "branches": 90,
        "functions": 95,
        "lines": 95,
        "statements": 95
      }
    },
    "moduleFileExtensions": [
      "js",
      "cjs",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testEnvironment": "node",
    "testRegex": "test/.*\\.test\\.ts$",
    "transform": {
      "^.+\\.ts$": [
        "@swc/jest",
        {
          "jsc": {
            "target": "es2022",
            "parser": {
              "syntax": "typescript"
            }
          },
          "module": {
            "type": "commonjs"
          }
        }
      ]
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/examples/"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/examples/"
    ]
  },
  "engines": {
    "node": ">=22"
  }
}
